{
  "id": "custom-codex-fetch",
  "name": "Custom Codex Fetch",
  "description": "Best-effort native page extraction fallback",
  "contracts": {
    "webFetchProviders": [
      "custom-codex-fetch"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "agentDir",
      "profileId",
      "binaryPath"
    ],
    "properties": {
      "agentDir": {
        "type": "string"
      },
      "profileId": {
        "type": "string"
      },
      "binaryPath": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000,
        "default": 90000
      },
      "startupMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 60000,
        "default": 15000
      },
      "cleanupMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 10000,
        "default": 5000
      },
      "model": {
        "type": "string",
        "default": "gpt-6-sol",
        "minLength": 1,
        "pattern": "\\S"
      },
      "effort": {
        "type": "string",
        "default": "low",
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ]
      }
    }
  },
  "uiHints": {
    "agentDir": {
      "label": "agentDir"
    },
    "profileId": {
      "label": "profileId"
    },
    "binaryPath": {
      "label": "binaryPath"
    },
    "timeoutMs": {
      "label": "timeoutMs"
    },
    "startupMs": {
      "label": "startupMs"
    },
    "cleanupMs": {
      "label": "cleanupMs"
    },
    "model": {
      "label": "Model",
      "help": "Authenticated native catalog model ID (default: gpt-6-sol); must support text and selected effort."
    },
    "effort": {
      "label": "Reasoning effort",
      "help": "Native reasoning effort (default: low); must be supported by selected model."
    }
  }
}
